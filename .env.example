# Copy this file to .env.local and adjust if needed.

# MySQL connection used by the web app (least-privilege account created by db/07_security.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_lostfound
DB_USER=lf_app
DB_PASSWORD=LfApp@2026

# Secret used to sign login session tokens (JWT). Use any long random string.
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Vector database (LanceDB, embedded) - folder where vector tables are stored
LANCEDB_DIR=./data/lancedb

# Embedding model: "transformer" (all-MiniLM-L6-v2, downloaded once ~23 MB) or "hash" (offline fallback)
EMBEDDING_MODE=transformer
